# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — nothing here leaves your machine.
#
# NOTE: GlareGuard guide mode needs NO Tesla credentials and NO car
# connection — the deflection plan is pure geometry computed locally.
# There is deliberately no TESLA_CLIENT_ID here. (The day Tesla's Fleet API
# exposes a side-mirror command, credentials get added for auto-actuation.)

# --- Your car ------------------------------------------------------------
# 3 | y | s | x | cybertruck
TGG_MODEL=3
# Model year — picks the right geometry band (e.g. Model 3 Highland 2024+)
TGG_YEAR=2022

# --- You -----------------------------------------------------------------
# Your height in cm — sets the eye point above the seat cushion
TGG_DRIVER_HEIGHT_CM=175
# Seat rail position: 0 = fully back, 1 = fully forward
TGG_SEAT_RAIL=0.5
# LHD | RHD
TGG_DRIVE_SIDE=LHD

# --- The dazzle scenario ---------------------------------------------------
# How far behind you the brights-on car is, in meters (8 is a typical gap)
TGG_FOLLOW_DISTANCE_M=8
# Move the reflected glare spot this many cm BELOW your eyes
TGG_DROP_CM=15
# Auto-restore the mirrors after this many seconds (second tap restores now)
TGG_RESTORE_SECONDS=60
# driver | both — deflect just your mirror, or the passenger mirror too
TGG_MIRROR=driver

# --- Notifications (optional) ----------------------------------------------
# ntfy.sh topic: the guide text ("tilt UP 3.8°, pan OUT 1.1°") is pushed to
# your phone/watch so a passenger can read it. Free, no account.
# Leave empty to print to the terminal only.
TGG_NTFY_TOPIC=

# --- Calibration -----------------------------------------------------------
# Multiplier applied to every computed angle. Tuned by `tgg calibrate`
# (persisted to the state file); set explicitly here to override.
TGG_GAIN=1.0
# Where deflection state + calibration gain are stored
TGG_STATE_FILE=~/.config/tesla-glareguard/state.json
